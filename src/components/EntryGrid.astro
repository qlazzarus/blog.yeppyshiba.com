---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import generatePlaceholder from '../utils/placeholderThumbnail.js';
import { sortDisplayTags } from '@/utils/tags';

interface Props {
    entries?: CollectionEntry<'blog'>[];
    basePath?: string;
    showViews?: boolean;
}

const { entries = [], basePath = '/article', showViews = true }: Props = Astro.props;

// GA page views (generated at build time). If the file doesn't exist, treat as empty.
type GaView = { path: string; totalCount: string };
let gaViews: GaView[] = [];
try {
    gaViews = ((await import('../data/ga-views.json')).default ?? []) as GaView[];
} catch {
    gaViews = [];
}

const viewMap = new Map<string, number>(
    gaViews.map((v) => [v.path, Number(v.totalCount) || 0]),
);

const normalizeHref = (p) => {
    if (!p) return p;
    // external URLs -> leave as-is
    if (/^https?:\/\//i.test(p) || /^\/\//.test(p)) return p;
    let out = p;
    if (!out.startsWith('/')) out = `/${out}`;
    if (!out.endsWith('/')) out = `${out}/`;
    return out;
};

const getPostHref = (post: any) => {
    if (post?.data?.originalPath) return normalizeHref(post.data.originalPath);
    return `${basePath}/${post.id}/`;
};
const isRide = (post: CollectionEntry<'blog'>) => Boolean(post.data.gpxUrl);
const getEntryType = (post: CollectionEntry<'blog'>) =>
    isRide(post) ? 'Ride' : post.data.category;
const getTypeHref = (post: CollectionEntry<'blog'>) =>
    isRide(post) ? '/rides/' : `/category/${post.data.category}/`;
const getViewCount = (post: CollectionEntry<'blog'>) =>
    viewMap.get(`${basePath}/${post.id}`) ?? viewMap.get(`${basePath}/${post.id}/`) ?? 0;
const canLoadViewStats = showViews && basePath === '/article';
const formatViewCount = (count: number) => count.toLocaleString('ko-KR');
---

<div class='grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3'>
    {
        entries.map((post) => (
            <article class='bg-card overflow-hidden rounded-lg border shadow-sm'>
                <a
                    href={getPostHref(post)}
                    class='relative block aspect-video w-full overflow-hidden'
                >
                    {(() => {
                        const src =
                            post.data.image ??
                            generatePlaceholder(post.data.title ?? post.id);
                        return (
                            <img
                                src={src}
                                alt={post.data.title || 'image'}
                                class='absolute inset-0 h-full w-full object-cover'
                                sizes='(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw'
                            />
                        );
                    })()}
                </a>

                <div class='p-4'>
                    {getEntryType(post) && (
                        <div class='text-muted-foreground mb-2 rounded text-xs capitalize'>
                            <a href={getTypeHref(post)}>
                                {getEntryType(post)}
                            </a>
                        </div>
                    )}

                    <h3 class='mb-1 text-lg font-semibold'>
                        <a href={getPostHref(post)} class='hover:underline'>
                            {post.data.title}
                        </a>
                    </h3>

                    <p class='text-muted-foreground mb-3 text-sm'>
                        {post.data.summary}
                    </p>

                    <div>
                        <div class='mb-2 flex flex-wrap gap-2'>
                            {sortDisplayTags(post.data.tags)
                                .slice(0, 5)
                                .map((tag) => (
                                    <a
                                        href={`/tag/${tag.slug}/`}
                                        class='bg-muted-foreground text-muted rounded px-2 py-0.5 text-xs'
                                    >
                                        {tag.label}
                                    </a>
                                ))}
                        </div>

                        <div class='text-muted-foreground flex items-center justify-between text-xs'>
                            {showViews ? (
                                (() => {
                                    const viewCount = getViewCount(post);
                                    return (
                                        <span
                                            aria-label='views'
                                            data-view-count={
                                                canLoadViewStats ? post.id : undefined
                                            }
                                            data-view-count-value={
                                                canLoadViewStats ? viewCount : undefined
                                            }
                                        >
                                            👀{' '}
                                            <span data-view-count-number>
                                                {viewCount === 0 ? '—' : formatViewCount(viewCount)}
                                            </span>
                                        </span>
                                    );
                                })()
                            ) : (
                                <span />
                            )}
                            <span class='text-right'>
                                <FormattedDate date={post.data.date} />
                            </span>
                        </div>
                    </div>
                </div>
            </article>
        ))
    }
</div>

{
    canLoadViewStats && (
        <script is:inline>
            (() => {
                if (!['blog.yeppyshiba.com', 'localhost', '127.0.0.1'].includes(window.location.hostname)) return;

                const nodes = [...document.querySelectorAll('[data-view-count]')];
                const ids = [...new Set(nodes.map((node) => node.dataset.viewCount).filter(Boolean))];
                if (ids.length === 0) return;

                const numberFormatter = new Intl.NumberFormat('ko-KR');
                const prefersReducedMotion = window.matchMedia(
                    '(prefers-reduced-motion: reduce)',
                ).matches;

                const setViewCount = (node, nextCount) => {
                    const numberNode = node.querySelector('[data-view-count-number]');
                    if (!numberNode) return;

                    const previousCount = Number(node.dataset.viewCountValue);
                    const formattedCount = numberFormatter.format(nextCount);
                    node.dataset.viewCountValue = String(nextCount);

                    if (prefersReducedMotion || previousCount === nextCount) {
                        numberNode.textContent = formattedCount;
                        return;
                    }

                    const digits = [...formattedCount].filter((character) => /\d/.test(character));
                    const previousDigits = Number.isFinite(previousCount)
                        ? numberFormatter
                              .format(Math.max(0, previousCount))
                              .replace(/\D/g, '')
                              .padStart(digits.length, '0')
                        : '';
                    const startsFromPlaceholder = previousCount === 0;
                    let digitIndex = 0;
                    const roller = document.createDocumentFragment();

                    for (const character of formattedCount) {
                        if (!/\d/.test(character)) {
                            roller.append(character);
                            continue;
                        }

                        const target = Number(character);
                        const previous = Number(previousDigits[digitIndex] ?? 0);
                        const start = startsFromPlaceholder ? (target + 4) % 10 : previous;
                        const turns = startsFromPlaceholder ? 10 : 0;
                        const steps = turns + ((target - start + 10) % 10);
                        const digit = document.createElement('span');
                        const strip = document.createElement('span');
                        digit.className = 'view-count-digit';
                        strip.className = 'view-count-digit-strip';

                        for (let step = 0; step <= steps; step += 1) {
                            const value = (start + step) % 10;
                            const frame = document.createElement('span');
                            frame.textContent = String(value);
                            strip.append(frame);
                        }

                        digit.append(strip);
                        roller.append(digit);
                        digitIndex += 1;
                    }

                    numberNode.replaceChildren(roller);
                    const strips = numberNode.querySelectorAll('.view-count-digit-strip');
                    const duration = startsFromPlaceholder ? 560 : 420;
                    strips.forEach((strip, index) => {
                        const distance = strip.children.length - 1;
                        strip.animate(
                            [
                                { transform: 'translateY(0)' },
                                { transform: `translateY(-${distance}em)` },
                            ],
                            {
                                delay: index * 28,
                                duration,
                                easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                                fill: 'forwards',
                            },
                        );
                    });

                    window.setTimeout(() => {
                        numberNode.textContent = formattedCount;
                    }, duration + strips.length * 28);
                };

                const query = new URLSearchParams({ ids: ids.join(',') });
                void fetch(`https://api.yeppyshiba.com/v1/stats?${query}`, {
                    credentials: 'include',
                })
                    .then((response) => (response.ok ? response.json() : Promise.reject()))
                    .then((payload) => {
                        if (!payload || typeof payload !== 'object' || !payload.stats) return;
                        for (const node of nodes) {
                            const count = payload.stats[node.dataset.viewCount];
                            if (typeof count === 'number' && Number.isFinite(count)) {
                                setViewCount(node, count);
                            }
                        }
                    })
                    .catch(() => {
                        // Keep the build-time GA4 value if the API is unavailable.
                    });
            })();
        </script>
    )
}

<style is:global>
    [data-view-count-number] {
        font-variant-numeric: tabular-nums;
    }

    .view-count-digit {
        display: inline-block;
        height: 1em;
        overflow: hidden;
        vertical-align: -0.12em;
        width: 1ch;
    }

    .view-count-digit-strip {
        display: block;
    }

    .view-count-digit-strip > span {
        display: block;
        height: 1em;
    }
</style>
